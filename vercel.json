{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "database/schema.sql"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Telegram|telegram|Twitter|WhatsApp|Discord|facebook|Facebot|meta-externalagent|Slack|LinkedIn|WebpageBot|vkShare|SkypeUriPreview|Applebot|Googlebot|bingbot|Viber|Line|Pinterest|Snapchat|Embedly|Iframely).*"
        }
      ],
      "destination": "/api/index.ts?__og=1"
    },
    {
      "source": "/((?!api/|assets/|og-preview\\.jpg|favicon\\.ico|favicon-32x32\\.png|favicon-48x48\\.png|icon-192\\.png|icon-512\\.png|apple-touch-icon\\.png|site\\.webmanifest).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Telegram|telegram|Twitter|WhatsApp|Discord|facebook|Facebot|meta-externalagent|Slack|LinkedIn|WebpageBot|vkShare|SkypeUriPreview|Applebot|Googlebot|bingbot|Viber|Line|Pinterest|Snapchat|Embedly|Iframely).*"
        }
      ],
      "destination": "/api/index.ts?__og=1"
    },
    {
      "source": "/((?!api/|assets/|og-preview\\.jpg|favicon\\.ico|favicon-32x32\\.png|favicon-48x48\\.png|icon-192\\.png|icon-512\\.png|apple-touch-icon\\.png|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/og-preview.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon-32x32\\.png|favicon-48x48\\.png|icon-192\\.png|icon-512\\.png|apple-touch-icon\\.png|site\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
