# ==============================================================================
# XC BOT CONTROL — Server & Vercel Environment Variables
# Never prefix secrets with VITE_ — keep all secrets strictly server-side.
# ==============================================================================

# Required in production: 64-char hex key (openssl rand -hex 32) for AES-256-GCM
# bot token encryption and HMAC-SHA256 stateless admin session signing.
XC_MASTER_KEY="CHANGE_ME_TO_A_STRONG_64_HEX_MASTER_KEY"

# Single-Admin Bootstrap Credentials (recommended on Vercel Serverless so admin
# login persists across cold starts without re-running initial setup)
XC_ADMIN_USERNAME="admin"
XC_ADMIN_DISPLAY_NAME="Lead Developer"
XC_ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

# Configured recovery code for the Forgot Password flow
XC_RECOVERY_CODE="XC-RECOVERY-2026"

# Optional Bot Token Provisioning (server-side only, encrypted at rest in SQLite)
# Single bot token:
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
# Or multiple tokens (comma-separated or JSON array):
# XC_BOT_TOKENS='[{"token":"123456789:ABC...","name":"Production Relay"}]'

# Optional: set to "true" on Vercel to seed sandbox demo workspace on cold start
XC_SEED_DEMO="false"

# Optional: canonical public HTTPS origin (auto-detected on Vercel via VERCEL_PROJECT_PRODUCTION_URL)
APP_URL="MY_APP_URL"
